import { ChevronDown, Search, ShoppingCart, CreditCard, Truck, RotateCcw, Leaf, Phone } from 'lucide-react';

type FAQ = { q: string; a: string };
type Section = { id: string; icon: React.ReactNode; title: string; faqs: FAQ[] };

